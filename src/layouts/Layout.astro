---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'FaqPage';
  noindex?: boolean;
}

const {
  title,
  description = 'Strategic coaching, transformational career support, and modern growth strategies for professionals, leaders, and coaches ready for their next chapter.',
  image,
  type,
  noindex,
} = Astro.props;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <SEO
    title={title}
    description={description}
    image={image}
    type={type}
    noindex={noindex}
  />

  <slot name="head" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:title" content="Pathway Career Coaching & Self Development" />
  <meta property="og:description" content="Strategic coaching, transformational career support, and modern growth strategies for professionals, leaders, and coaches ready for their next chapter." />
  <meta property="og:image" content="https://yourpathwaycareercoach.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://yourpathwaycareercoach.com/" />
  <meta property="og:type" content="website" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Performance -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

  <meta name="theme-color" content="#b87e27" />
</head>
  <body>
    <AnnouncementBar />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Staggered children
      document.querySelectorAll('.stagger-children > *').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${i * 100}ms`;
        el.classList.add('reveal');
        observer.observe(el);
      });

      // Nav scroll behavior
      const nav = document.getElementById('main-nav');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
          nav?.classList.add('nav-scrolled');
        } else {
          nav?.classList.remove('nav-scrolled');
        }
      });
    </script>
    <!-- phone insertion script begins -->

    <script is:inline>
      (function () {
        var findNum = '2039822881';   // digits only, no country code
        var replaceNum = '8602645302'; // digits only, no country code

        function formatNum(digits) {
          return '(' + digits.substring(0,3) + ') ' + digits.substring(3,6) + '-' + digits.substring(6,10);
        }

        function walk(node) {
          if (node.nodeType === 3) { // text node
            if (node.nodeValue.indexOf(findNum) === -1) {
              // also check common formatted variants
              var patterns = [
                findNum,
                findNum.substring(0,3) + '-' + findNum.substring(3,6) + '-' + findNum.substring(6,10),
                findNum.substring(0,3) + '.' + findNum.substring(3,6) + '.' + findNum.substring(6,10),
                '(' + findNum.substring(0,3) + ') ' + findNum.substring(3,6) + '-' + findNum.substring(6,10),
              ];
              for (var p of patterns) {
                if (node.nodeValue.indexOf(p) !== -1) {
                  node.nodeValue = node.nodeValue.split(p).join(formatNum(replaceNum));
                }
              }
            }
            return;
          }
          if (node.nodeType === 1) { // element node
            // handle tel: links specifically
            if (node.tagName === 'A' && node.href && node.href.indexOf(findNum) !== -1) {
              node.href = node.href.split(findNum).join(replaceNum);
            }
            for (var i = 0; i < node.childNodes.length; i++) {
              walk(node.childNodes[i]);
            }
          }
        }

        function run() {
          walk(document.body);
        }

        if (document.readyState === 'complete') {
          run();
        } else {
          window.addEventListener('load', run);
        }
      })();
    </script>

    <!-- phone insertion script ends -->
  </body>
</html>
