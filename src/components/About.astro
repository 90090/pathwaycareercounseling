---
const CALENDLY_URL = "https://calendly.com/selfdevelopmentpathway/30min";
---

<section id="about" class="relative py-28 overflow-hidden"
  style="background: linear-gradient(180deg, #f8efee 0%, #f2e0de 100%);">

  <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-5 pointer-events-none hidden lg:block"
    style="background: repeating-linear-gradient(45deg, #b87e27 0px, #b87e27 1px, transparent 1px, transparent 20px);">
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">

      <!-- Left: Image + below-image content -->
      <div class="reveal flex flex-col gap-10">

        <!-- Image block -->
        <div class="relative">
          <div class="absolute -top-4 -left-4 w-full h-full border border-gold-400/30"></div>
          <div class="relative overflow-hidden" style="aspect-ratio: 3/4; max-width: 480px;">
            <img
              src="./aboutme.jpg"
              alt="Erica Peryga — Career Strategist & Coach"
              class="w-full h-full object-cover object-top"
            />
          </div>
          <div class="absolute bottom-8 -right-4 lg:-right-8 bg-cream-50 border border-cream-200 shadow-xl p-6 max-w-[200px]">
            <div class="font-display text-4xl text-gold-500 mb-1">15+</div>
            <div class="font-body text-xs tracking-widest uppercase text-charcoal-800/60 leading-tight">Years in Career Strategy & Leadership Development</div>
          </div>
        </div>

        <!-- Below image: Philosophy + Credentials -->
        <div class="flex flex-col gap-8 lg:pr-8">

          <!-- Philosophy -->
          <div class="border-l-2 border-gold-400 pl-5">
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-gold-500 mb-2">Philosophy</p>
            <p class="font-body text-charcoal-900 text-base leading-relaxed">
              Your career shouldn't just be something you manage—it should be something you design.
            </p>
          </div>

          <!-- Credentials -->
          <div>
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-charcoal-800/40 mb-4">Credentials</p>
            <div class="flex flex-wrap gap-2">
              {[
                "CPRW Certified",
                "M.S. Counselor Education",
                "B.S. Social Work",
                "Speaker & Trainer",
                "Podcast Host",
              ].map(cred => (
                <span class="font-body text-xs tracking-wider px-3 py-1.5 border border-gold-400/40 text-gold-600 uppercase">
                  {cred}
                </span>
              ))}
            </div>
          </div>

          <!-- Featured In -->
          <div>
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-charcoal-800/40 mb-4">Featured In</p>
            <div class="flex flex-wrap gap-2">
              {[
                "LinkedIn",
                "Career Thought Leaders",
                "Career Karma",
                "Influential Women",
                "Industry Conferences",
                "Podcast Features",
              ].map(pub => (
                <span class="font-body text-xs tracking-wider px-3 py-1.5 bg-charcoal-900/5 text-charcoal-800/60 uppercase">
                  {pub}
                </span>
              ))}
            </div>
          </div>

        </div>
      </div>

      <!-- Right: Bio text -->
      <div class="reveal flex flex-col gap-8">

        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="shimmer-line w-8 h-px block"></span>
            <span class="section-label">About Erica</span>
          </div>

          <h2 class="font-display text-5xl lg:text-6xl text-charcoal-900 leading-tight mb-8">
            Career Strategist. Speaker.<br />
            <em class="text-gradient-gold">Thought Leader.</em>
          </h2>

          <div class="space-y-5 font-body text-charcoal-800/70 leading-relaxed">
            <p>
              Erica Peryga is a transformational career strategist, speaker, and founder of <strong class="text-charcoal-900">The Pathway Method</strong> — a framework designed to help professionals reinvent their careers and confidently navigate what comes next.
            </p>
            <p>
              With more than 15 years of experience in career development, leadership, higher education, coaching, and workforce strategy, Erica helps professionals, leaders, and coaches move from feeling stuck and uncertain to clear, confident, and strategically aligned.
            </p>
            <p>Her work blends career reinvention, leadership development, future-focused strategy, AI innovation, human-centered coaching, and transformational growth.</p>
            <p>
              Through her signature framework, <strong class="text-charcoal-900">The Pathway Method</strong>, Erica guides individuals to:
            </p>
          </div>
        </div>

        <!-- Pathway Method bullets -->
        <ul class="space-y-3">
          {[
            "Gain clarity on their direction",
            "Reposition their experience for new opportunities",
            "Build confidence in how they show up",
            "Take strategic, aligned action toward what's next",
          ].map(item => (
            <li class="flex items-start gap-3 font-body text-sm text-charcoal-800/70">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500 shrink-0 mt-0.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <p class="font-body text-charcoal-800/70 leading-relaxed">
          Her approach goes beyond traditional career coaching. It's about helping people reinvent their careers, rebuild their confidence, and create what's next — without starting over.
        </p>

        <!-- Areas of Expertise -->
        <div>
          <p class="font-body text-[10px] tracking-[0.25em] uppercase text-charcoal-800/40 mb-4">Areas of Expertise</p>
          <div class="flex flex-wrap gap-3">
            {[
              "Career Strategy & Reinvention",
              "Leadership Development",
              "Personal Brand & Positioning",
              "AI & Future of Work",
              "Confidence & Mindset",
              "Coach Systems & Growth",
            ].map(area => (
              <span class="font-body text-xs tracking-wider px-4 py-2 border border-gold-400/40 text-gold-600 uppercase">
                {area}
              </span>
            ))}
          </div>
        </div>

        <div>
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Work With Me
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
