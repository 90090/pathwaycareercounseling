---
const CALENDLY_URL = "https://calendly.com/YOUR_LINK_HERE";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden bg-hero-gradient noise-overlay"
  style="padding-top: calc(var(--bar-height, 44px) + 80px);"
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full opacity-20"
      style="background: radial-gradient(circle, #b87e27 0%, transparent 70%);">
    </div>
    <div class="absolute bottom-0 -left-24 w-[400px] h-[400px] rounded-full opacity-10"
      style="background: radial-gradient(circle, #9a681e 0%, transparent 70%);">
    </div>
    <div class="absolute top-1/3 right-16 w-px h-48 bg-gradient-to-b from-transparent via-gold-400/30 to-transparent hidden lg:block"></div>
    <div class="absolute top-1/2 right-32 w-px h-32 bg-gradient-to-b from-transparent via-gold-400/20 to-transparent hidden lg:block"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-start min-h-[85vh] py-20">

      <!-- Left: Text Content -->
      <div class="flex flex-col justify-center">

        <!-- Pre-headline label -->
        <div class="flex items-center gap-3 mb-8 opacity-0 animate-fade-in" style="animation-delay: 200ms; animation-fill-mode: forwards;">
          <span class="shimmer-line w-8 h-px block"></span>
          <span class="section-label">The Pathway Method</span>
        </div>

        <!-- Main headline -->
        <h1 class="font-display text-5xl lg:text-6xl xl:text-7xl leading-[1.08] tracking-tight text-charcoal-900 mb-6 opacity-0 animate-fade-up" style="animation-delay: 300ms; animation-fill-mode: forwards;">
          Reinvent Your Career.<br />
          Rebuild Your Confidence.<br />
          <em class="text-gradient-gold not-italic">Create What's Next.</em>
        </h1>

        <!-- Subheadline -->
        <p class="font-body text-lg text-charcoal-800/70 leading-relaxed max-w-md mb-8 opacity-0 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: forwards;">
          Strategic coaching, transformational career support, and modern growth strategies for professionals, leaders, and coaches ready for their next chapter.
        </p>

        <!-- Who I Work With -->
        <div class="mb-10 opacity-0 animate-fade-up" style="animation-delay: 475ms; animation-fill-mode: forwards;">
          <p class="font-body text-[10px] tracking-[0.25em] uppercase text-gold-500 mb-4">Who I Work With</p>
          <ul class="space-y-2">
            {[
              "Professionals ready for their next level",
              "Individuals navigating career transitions",
              "Leaders stepping into greater impact",
              "Coaches ready to simplify, scale, and grow",
            ].map(item => (
              <li class="flex items-center gap-3 font-body text-sm text-charcoal-800/70">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500 shrink-0">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Social proof strip -->
        <div class="flex items-center gap-6 pb-10 border-b border-gold-500/20 opacity-0 animate-fade-up" style="animation-delay: 550ms; animation-fill-mode: forwards;">
          <div class="text-center">
            <div class="font-display text-3xl text-gold-500 font-semibold">15+</div>
            <div class="font-body text-xs tracking-widest uppercase text-charcoal-800/60 mt-1">Years Experience</div>
          </div>
          <div class="w-px h-10 bg-gold-500/20"></div>
          <div class="text-center">
            <div class="font-display text-3xl text-gold-500 font-semibold">500+</div>
            <div class="font-body text-xs tracking-widest uppercase text-charcoal-800/60 mt-1">Lives Transformed</div>
          </div>
          <div class="w-px h-10 bg-gold-500/20"></div>
          <div class="text-center">
            <div class="font-display text-3xl text-gold-500 font-semibold">CPRW</div>
            <div class="font-body text-xs tracking-widest uppercase text-charcoal-800/60 mt-1">Certified Resume Writer</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-10 opacity-0 animate-fade-up" style="animation-delay: 625ms; animation-fill-mode: forwards;">
          <a href="/quiz" class="btn-primary">
            Take the Career Destiny Quiz™
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">
            Book a Free Discovery Call
          </a>
        </div>

      </div>

      <!-- Right: Image + Speaking & Training below -->
      <div class="flex flex-col gap-10 justify-start opacity-0 animate-fade-in" style="animation-delay: 400ms; animation-fill-mode: forwards;">

        <!-- Image frame -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <div class="absolute -top-3 -left-3 w-12 h-12 border-t-2 border-l-2 border-gold-500 z-20"></div>
            <div class="absolute -bottom-3 -right-3 w-12 h-12 border-b-2 border-r-2 border-gold-500 z-20"></div>

            <div class="relative w-[340px] lg:w-[420px] h-[480px] lg:h-[560px] overflow-hidden"
              style="background: linear-gradient(160deg, #e8cbc8 0%, #d4a98b 50%, #c49060 100%);">
              <div class="relative overflow-hidden" style="aspect-ratio: 3/4; max-width: 480px;">
                <img
                  src="./headshotabout.JPG"
                  alt="Erica Peryga — Career Strategist & Coach"
                  class="w-full h-full object-cover object-top"
                />
              </div>
              <div class="absolute bottom-0 left-0 right-0 h-32"
                style="background: linear-gradient(to top, rgba(184,126,39,0.15), transparent);">
              </div>
            </div>

            <div class="absolute -bottom-6 -left-6 bg-charcoal-900 text-cream-100 px-6 py-4 shadow-xl z-30">
              <div class="font-display text-sm italic text-gold-300 mb-1">Nationally Recognized</div>
              <div class="font-body text-xs tracking-widest uppercase text-cream-200/70">Career & Self-Development Coach</div>
            </div>
          </div>
        </div>

        <!-- Speaking & Training — fills space below image -->
        <div class="pt-4 border-t border-gold-500/20">
          <div class="flex items-center gap-3 mb-3">
            <span class="shimmer-line w-6 h-px block"></span>
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-gold-500">Speaking & Training</p>
          </div>
          <p class="font-body text-sm text-charcoal-800/60 leading-relaxed mb-4">
            Erica is a speaker and thought leader on career reinvention, leadership, AI, and the future of work — partnering with organizations and events to deliver high-impact experiences that drive clarity, confidence, and results.
          </p>
          <a href="/speaking" class="inline-flex items-center gap-2 font-body text-xs tracking-[0.15em] uppercase text-gold-500 hover:text-gold-600 transition-colors duration-300 group">
            Learn More About Speaking & Training
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-60">
    <span class="font-body text-[10px] tracking-[0.3em] uppercase text-charcoal-800/50">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-gold-500 to-transparent animate-pulse"></div>
  </div>
</section>
