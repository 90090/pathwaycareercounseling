---
const stats = [
  { value: "500+", label: "Clients Coached", sublabel: "Across industries & career stages" },
  { value: "94%", label: "Success Rate", sublabel: "Clients land roles within 90 days" },
  { value: "3×", label: "Salary Increase", sublabel: "Average client salary jump" },
  { value: "15+", label: "Years Experience", sublabel: "In career & leadership development" },
  { value: "200+", label: "Tech Placements", sublabel: "At top-tier tech companies" },
  { value: "#1", label: "Nationally Recognized", sublabel: "Career & self-development coach" },
];

const mediaLogos = [
  { name: "Influential Women", placeholder: "./asSeenon/influentialwomenlogo.png" },
  { name: "Career Karma", placeholder: "./asSeenon/careerkarma.png" },
  { name: "LinkedIn", placeholder: "./asSeenon/linkedinlogo.png" },
  { name: "Career Thought Leaders Symposium", placeholder: "./asSeenon/CTL.png" },
];
---

<!-- Results by the Numbers -->
<section id="results" class="py-28 bg-charcoal-900 relative overflow-hidden">

  <!-- Decorative -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full opacity-10"
      style="background: radial-gradient(ellipse, #b87e27 0%, transparent 70%);">
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-16 reveal">
      <div class="flex items-center justify-center gap-3 mb-6">
        <span class="shimmer-line w-8 h-px block"></span>
        <span class="section-label">Results By The Numbers</span>
        <span class="shimmer-line w-8 h-px block"></span>
      </div>
      <h2 class="font-display text-5xl lg:text-6xl text-cream-100 leading-tight">
        <em class="text-gradient-gold">The Pathway Method in Action</em>
      </h2>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-gold-500/10">
      {stats.map((stat, i) => (
        <div
          class="reveal bg-charcoal-900 p-8 lg:p-12 text-center hover:bg-charcoal-800 transition-colors duration-300 group"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="font-display text-5xl lg:text-6xl text-gradient-gold mb-3 group-hover:scale-105 transition-transform duration-300">
            {stat.value}
          </div>
          <div class="font-body text-sm tracking-wider uppercase text-cream-100 mb-2">{stat.label}</div>
          <div class="font-body text-xs text-cream-200/40">{stat.sublabel}</div>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- As Seen On -->
<section class="py-20 bg-cream-200/50 border-y border-cream-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <div class="text-center mb-12 reveal">
      <span class="section-label">As Seen On</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-8 lg:gap-16 stagger-children">
      {mediaLogos.map((logo) => (
        <div class="reveal group flex items-center justify-center">
          <div class="h-20 px-6 flex items-center justify-center min-w-[100px] transition-colors duration-300">
            <img src={logo.placeholder} alt={logo.name} class="h-full object-contain" />
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
