---
const CALENDLY_URL = "https://calendly.com/selfdevelopmentpathway/30min";

const talks = [
  {
    title: "The Pathway Method: Reinvent Your Career Without Starting Over",
    description: "A framework-driven talk that challenges the idea that a career change means starting from scratch. Audiences walk away with a clear, actionable model for identifying their transferable value and designing their next move with confidence.",
  },
  {
    title: "The New Career Playbook: What It Really Takes to Stand Out, Get Hired, and Grow",
    description: "A straight-talking session on what's actually changed in hiring, positioning, and career growth—and the specific strategies that separate those who land opportunities from those who stay stuck.",
  },
  {
    title: "From Burnout to Bold: Redefining Success and Taking Back Control of Your Career",
    description: "An honest conversation about what burnout really signals—and how to use that moment as a catalyst for clarity, realignment, and purposeful career design.",
  },
  {
    title: "The Pathway to Career Futures: AI, Confidence & the Strategies That Actually Work",
    description: "A forward-looking talk on how AI is reshaping the job market and what professionals need to do now—not just tactically, but mindset-wise—to stay relevant, competitive, and confident.",
  },
];

const formats = [
  { label: "Keynote Speaking", icon: `<path d="M12 22V12M12 12L8 16M12 12L16 16M20 7H4M17 7l-1-4H8L7 7"/>` },
  { label: "Workshops", icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>` },
  { label: "Team Training", icon: `<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/>` },
  { label: "Panels & Events", icon: `<path d="M8 3H2v15h7c1.7 0 3 1.3 3 3V7c0-2.2-1.8-4-4-4Z"/><path d="M16 3h6v15h-7c-1.7 0-3 1.3-3 3V7c0-2.2 1.8-4 4-4Z"/>` },
];
---

<section id="speaking-page" class="py-24">

  <!-- Page Hero -->
  <div class="relative pt-12 pb-24 overflow-hidden"
    style="background: linear-gradient(160deg, #f8efee 0%, #f2e0de 60%, #e8cbc8 100%);">
    <div class="absolute top-1/3 right-16 w-px h-48 bg-gradient-to-b from-transparent via-gold-400/20 to-transparent hidden lg:block"></div>
    <div class="absolute top-1/2 right-32 w-px h-32 bg-gradient-to-b from-transparent via-gold-400/15 to-transparent hidden lg:block"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-gold-500 block"></span>
            <span class="font-body text-xs tracking-[0.25em] uppercase text-gold-500">Speaking & Training</span>
          </div>
          <h1 class="font-display text-5xl lg:text-6xl text-charcoal-900 leading-tight mb-8">
            Speaking That Moves People—<br />
            <em class="text-gradient-gold">and Drives Results.</em>
          </h1>
          <div class="space-y-5 font-body text-charcoal-800/70 leading-relaxed mb-10">
            <p>
              Erica Peryga is a speaker, career strategist, and thought leader on career reinvention, leadership development, AI, and the future of work.
            </p>
            <p>
              She partners with organizations, conferences, leadership teams, and professional communities to deliver transformational keynotes, workshops, and training experiences that inspire clarity, confidence, strategic action, and lasting impact.
            </p>
            <p>
              Blending human-centered coaching with cutting-edge technology, AI innovation, and modern career strategies, Erica helps professionals and organizations navigate career transformation, workforce evolution, leadership growth, and the rapidly changing future of careers.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#speaking-contact" class="btn-primary">
              Book Erica to Speak
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
            <a href="#talks" class="btn-outline">View Signature Talks</a>
          </div>
        </div>

        <!-- Formats grid -->
        <div class="grid grid-cols-2 gap-4">
          {formats.map((format) => (
            <div class="bg-white border border-cream-200 p-6 flex flex-col gap-4 hover:border-gold-400/40 transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500">
                <Fragment set:html={format.icon} />
              </svg>
              <p class="font-body text-xs tracking-[0.2em] uppercase text-charcoal-900">{format.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Signature Talks -->
  <div id="talks" class="py-24 lg:py-32 bg-cream-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-xl mb-16 reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-8 h-px bg-gold-500 block"></span>
          <span class="font-body text-xs tracking-[0.25em] uppercase text-gold-500">Signature Talks</span>
        </div>
        <h2 class="font-display text-4xl lg:text-5xl text-charcoal-900 leading-tight">
          Topics That Resonate.<br />
          <em class="text-gradient-gold">Frameworks That Stick.</em>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {talks.map((talk, i) => (
          <div class="reveal bg-white border border-cream-200 hover:border-gold-400/40 transition-colors duration-300 p-8 flex flex-col gap-4">
            <div class="flex items-start gap-4">
              <span class="font-display text-4xl text-gold-500/20 leading-none shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-xl text-charcoal-900 leading-snug">{talk.title}</h3>
            </div>
            <p class="font-body text-sm text-charcoal-800/60 leading-relaxed">{talk.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA / Contact -->
  <div id="speaking-contact" class="py-24 lg:py-32 bg-charcoal-900 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5" style="background: radial-gradient(ellipse at center, #b87e27 0%, transparent 60%);"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-gold-500 block"></span>
            <span class="font-body text-xs tracking-[0.25em] uppercase text-gold-400">Book Erica</span>
          </div>
          <h2 class="font-display text-4xl lg:text-5xl text-cream-100 leading-tight mb-6">
            Let's Create an<br />
            <em class="text-gradient-gold">Unforgettable Experience.</em>
          </h2>
          <p class="font-body text-cream-200/60 leading-relaxed mb-8">
            Whether you're planning a conference, corporate event, leadership summit, or team workshop — Erica will deliver a session your audience remembers and acts on.
          </p>
          <div class="border-t border-gold-500/20 pt-8">
            <p class="font-body text-[10px] tracking-[0.25em] uppercase text-gold-500 mb-4">What to Expect</p>
            <ul class="space-y-3">
              {[
                "A response within 48 hours",
                "A brief discovery call to discuss your event and goals",
                "Customized talk framing for your audience",
                "Full support from inquiry through event day",
              ].map(item => (
                <li class="flex items-start gap-3 font-body text-sm text-cream-200/70">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500 shrink-0 mt-0.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div>
          <form id="speaking-form" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">First Name *</label>
                <input type="text" name="firstName" required placeholder="Jane" class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 placeholder-cream-200/20 focus:outline-none focus:border-gold-500 transition-colors" />
              </div>
              <div>
                <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">Last Name</label>
                <input type="text" name="lastName" placeholder="Smith" class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 placeholder-cream-200/20 focus:outline-none focus:border-gold-500 transition-colors" />
              </div>
            </div>
            <div>
              <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">Email Address *</label>
              <input type="email" name="email" required placeholder="you@organization.com" class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 placeholder-cream-200/20 focus:outline-none focus:border-gold-500 transition-colors" />
            </div>
            <div>
              <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">Organization / Event</label>
              <input type="text" name="organization" placeholder="Company or event name" class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 placeholder-cream-200/20 focus:outline-none focus:border-gold-500 transition-colors" />
            </div>
            <div>
              <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">Format</label>
              <select name="format" class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 focus:outline-none focus:border-gold-500 transition-colors appearance-none">
                <option value="">Select a format...</option>
                <option value="keynote">Keynote Speaking</option>
                <option value="workshop">Workshop</option>
                <option value="team-training">Team Training</option>
                <option value="panel">Panel / Event</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>
            <div>
              <label class="font-body text-xs tracking-widest uppercase text-cream-200/40 block mb-2">Tell Us About Your Event *</label>
              <textarea name="message" required rows={4} placeholder="Event date, audience size, goals, and any other details..." class="w-full font-body text-sm px-5 py-4 bg-charcoal-900 border border-cream-200/10 text-cream-100 placeholder-cream-200/20 focus:outline-none focus:border-gold-500 transition-colors resize-none"></textarea>
            </div>
            <button type="submit" id="speaking-submit" class="w-full btn-primary justify-center text-sm py-5">
              Request Speaking Information
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
              </svg>
            </button>
          </form>
          <div id="speaking-success" class="hidden text-center py-12">
            <div class="w-16 h-16 rounded-full bg-gold-500/10 flex items-center justify-center mx-auto mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#b87e27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="font-display text-3xl text-cream-100 mb-3">Request Received!</h3>
            <p class="font-body text-cream-200/60">Thank you for your interest. Erica's team will be in touch within 48 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<script>
  const form = document.getElementById('speaking-form') as HTMLFormElement;
  const success = document.getElementById('speaking-success');
  const submitBtn = document.getElementById('speaking-submit') as HTMLButtonElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;
    const data = Object.fromEntries(new FormData(form).entries());
    try { await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, type: 'speaking' }) }); } catch {}
    form.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
