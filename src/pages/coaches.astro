---
import Layout from '../layouts/Layout.astro';
import CoachQuiz from '../components/CoachQuiz.tsx';

const CALENDLY_URL = "https://calendly.com/selfdevelopmentpathway/30min";

const offers = [
  {
    title: "Coaching Systems Audit",
    subtitle: "90-Minute Working Session",
    description: "A focused deep-dive into your current coaching business infrastructure. We'll review your lead tracking, follow-up strategy, workflow, and backend clarity — and map out exactly what needs to change.",
    includes: ["Lead tracking review", "Follow-up strategy assessment", "Workflow optimization", "Backend clarity & action plan"],
    pricing: "Fixed Investment",
    accent: false,
  },
  {
    title: "Pathway Systems Implementation",
    subtitle: "Full Business Infrastructure Build",
    description: "A comprehensive implementation experience where we build the backend systems your coaching business needs to grow, scale, and run without chaos.",
    includes: ["CRM setup & configuration", "Workflows & automation", "Client onboarding systems", "Client journey mapping", "Nurture & follow-up systems"],
    pricing: "Custom Pricing",
    accent: true,
  },
  {
    title: "Pathway Coach Support Membership",
    subtitle: "Ongoing Monthly Partnership",
    description: "Ongoing strategic support for coaches who want a thought partner, systems expert, and accountability partner in their corner every month.",
    includes: ["Monthly strategy calls", "Backend troubleshooting", "AI implementation guidance", "Workflow optimization", "Accountability & momentum"],
    pricing: "By Application",
    accent: false,
  },
];
---

<Layout
  title="For Coaches | Pathway Career Coaching"
  description="Support for coaches ready to simplify their backend, scale their impact, and build a coaching business that runs with clarity, confidence, and ease."
>

  <!-- Hero -->
  <section class="relative pt-36 pb-24 overflow-hidden"
    style="background: linear-gradient(160deg, #f8efee 0%, #f2e0de 60%, #e8cbc8 100%);">
    <div class="absolute top-1/3 right-16 w-px h-48 bg-gradient-to-b from-transparent via-gold-400/20 to-transparent hidden lg:block"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-8 h-px bg-gold-500 block"></span>
            <span class="font-body text-xs tracking-[0.25em] uppercase text-gold-500">For Coaches</span>
          </div>
          <h1 class="font-display text-5xl lg:text-6xl text-charcoal-900 leading-tight mb-8">
            Simplify. Scale.<br />
            <em class="text-gradient-gold">Grow.</em>
          </h1>
          <div class="space-y-5 font-body text-charcoal-800/70 leading-relaxed mb-10">
            <p>
              Helping coaches simplify, scale, and grow without losing the human side of their business.
            </p>
            <p>
              Most coaches are incredible at transformation — but overwhelmed by systems, follow-up, operations, and scalability. That's where Erica comes in.
            </p>
            <p>
              This work blends coaching, systems, lead management, AI integration, operations, and transformation to help coaches build businesses that support their growth — not slow it down.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
              Book a Strategy Call
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
            <a href="#coach-quiz" class="btn-outline">Take the Coach Quiz</a>
          </div>
        </div>

        <!-- Right: What we address -->
        <div class="reveal grid grid-cols-2 gap-4">
          {[
            { label: "Systems & Operations", icon: `<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/>` },
            { label: "Lead Generation", icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>` },
            { label: "AI Integration", icon: `<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-1H1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73A2 2 0 0 1 10 4a2 2 0 0 1 2-2z"/>` },
            { label: "Client Experience", icon: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>` },
            { label: "Workflow Automation", icon: `<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/>` },
            { label: "Scalable Growth", icon: `<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>` },
          ].map(item => (
            <div class="bg-white border border-cream-200 p-6 flex flex-col gap-3 hover:border-gold-400/40 transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500">
                <Fragment set:html={item.icon} />
              </svg>
              <p class="font-body text-xs tracking-[0.15em] uppercase text-charcoal-900">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Offers -->
  <section class="py-24 lg:py-32 bg-cream-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="max-w-xl mb-16 reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="shimmer-line w-8 h-px block"></span>
          <span class="section-label">Coach Offers</span>
        </div>
        <h2 class="font-display text-4xl lg:text-5xl text-charcoal-900 leading-tight">
          The Right Support<br />
          <em class="text-gradient-gold">At Every Stage.</em>
        </h2>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        {offers.map((offer) => (
          <div class={`reveal flex flex-col p-8 border ${offer.accent ? 'bg-charcoal-900 border-gold-500/40' : 'bg-white border-cream-200 hover:border-gold-400/40'} transition-colors duration-300`}>
            <div class="mb-6">
              <span class={`inline-block font-body text-[10px] tracking-[0.25em] uppercase px-3 py-1 ${offer.accent ? 'bg-gold-500 text-cream-50' : 'bg-cream-100 text-gold-600 border border-gold-400/30'}`}>
                {offer.pricing}
              </span>
            </div>
            <h3 class={`font-display text-2xl mb-2 ${offer.accent ? 'text-cream-100' : 'text-charcoal-900'}`}>{offer.title}</h3>
            <p class={`font-body text-xs tracking-wider uppercase mb-4 ${offer.accent ? 'text-gold-300' : 'text-gold-500'}`}>{offer.subtitle}</p>
            <p class={`font-body text-sm leading-relaxed mb-8 flex-1 ${offer.accent ? 'text-cream-200/70' : 'text-charcoal-800/60'}`}>{offer.description}</p>
            <ul class="space-y-2 mb-8">
              {offer.includes.map(item => (
                <li class={`flex items-start gap-3 font-body text-sm ${offer.accent ? 'text-cream-200/80' : 'text-charcoal-800/70'}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-gold-500 shrink-0 mt-0.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer"
              class={`inline-flex items-center gap-2 font-body text-xs tracking-[0.15em] uppercase transition-all duration-300 group ${offer.accent ? 'text-gold-300 hover:text-gold-200' : 'text-gold-500 hover:text-gold-600'}`}>
              Let's Talk
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform duration-300">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coach Quiz -->
  <section id="coach-quiz" class="py-24 lg:py-32"
    style="background: linear-gradient(160deg, #f8efee 0%, #f2e0de 100%);">
    <div class="max-w-3xl mx-auto px-6 lg:px-12">
      <div class="text-center mb-14">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="w-8 h-px bg-gold-500 block"></span>
          <span class="font-body text-xs tracking-[0.25em] uppercase text-gold-500">Free Assessment</span>
          <span class="w-8 h-px bg-gold-500 block"></span>
        </div>
        <h2 class="font-display text-4xl lg:text-5xl text-charcoal-900 leading-tight mb-6">
          Discover Your Coaching<br />
          <em class="text-gradient-gold">Growth Path™</em>
        </h2>
        <p class="font-body text-charcoal-800/60 max-w-lg mx-auto">
          Uncover the strengths, opportunities, and next-level strategies designed to help your coaching business grow with more clarity, confidence, and ease.
        </p>
      </div>
      <CoachQuiz client:load />
    </div>
  </section>

</Layout>
